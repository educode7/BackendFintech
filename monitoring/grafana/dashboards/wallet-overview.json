{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request rate (req/s) by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by(application) (rate(http_server_requests_seconds_count{application=~\"api-gateway|payment-service|account-service|notification-service\"}[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "Error rate (5xx) by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by(application) (rate(http_server_requests_seconds_count{application=~\"api-gateway|payment-service|account-service|notification-service\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "Latency p95 by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, uri, application) (rate(http_server_requests_seconds_bucket{application=~\"api-gateway|payment-service|account-service|notification-service\"}[5m])))",
          "legendFormat": "{{application}} {{uri}}"
        }
      ]
    },
    {
      "title": "Circuit breaker state",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "kafka_consumer_fetch_manager_records_lag",
          "legendFormat": "{{client_id}}"
        }
      ]
    },
    {
      "title": "Events published vs consumed (rate/min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(spring_kafka_template_send_total[1m]))",
          "legendFormat": "published"
        },
        {
          "expr": "sum(rate(spring_kafka_listener_records_consumed_total[1m]))",
          "legendFormat": "consumed"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["wallet"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
