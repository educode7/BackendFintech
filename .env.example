# GitHub fine-grained Personal Access Token with Issues: Read and write
# permission on this repository. Leave empty to force DRY_RUN mode.
GITHUB_TOKEN=

# Repository that receives the issues, format owner/name.
GITHUB_REPO=educode7/BackendFintech

# Shared secret sent by Alertmanager as "Authorization: Bearer <secret>".
# Must match the content of monitoring/alerts/webhook_secret.txt.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# true = never call GitHub, only log the intended actions.
DRY_RUN=true
